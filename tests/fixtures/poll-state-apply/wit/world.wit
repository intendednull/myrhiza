// Local copy of the kernel WIT for the fixture.
//
// The production canonical ABI lives at `wit/myrhiza-kernel/wit/`.
// We re-declare a structurally-compatible subset here because
// wit-bindgen requires the target's WIT inside the fixture crate.
//
// Critically: the package name + interface names below mirror the
// production kernel package so the resulting component's import
// paths match what `WasmtimeBackend::instantiate_state_apply`
// expects when its bindgen-generated linker looks up
// `myrhiza:kernel/host-deterministic` and the `verdict` use-clause
// on `myrhiza:kernel/types`.
package myrhiza:kernel@1.0.0;

interface types {
    variant verdict {
        accept,
        reject(string),
    }
}

interface host-deterministic {
    hash: func(bytes: list<u8>) -> list<u8>;
    log: func(level: u8, msg: string);
}

world state-apply {
    import host-deterministic;
    use types.{verdict};
    export apply: func(prior-state: list<u8>, event: list<u8>) ->
        tuple<verdict, list<u8>>;
    export state-digest: func(state: list<u8>) -> list<u8>;
}
