// Local copy of the kernel WIT for the fixture.
//
// The production canonical ABI lives at `wit/myrhiza-kernel/wit/`.
// We re-declare a structurally-compatible subset here because
// wit-bindgen requires the target's WIT inside the fixture crate.
//
// The package name + interface names mirror the production kernel
// package so the resulting component's import paths match what
// `WasmtimeBackend::instantiate_interaction` expects when its
// bindgen-generated linker looks up `myrhiza:kernel/host-deterministic`.
//
// The production `interaction` world also declares imports for
// `host-non-deterministic`, `host-async`, and `host-ui-surfaces`.
// We DROP those here: counter's v1 interaction uses only
// `host-deterministic` (it calls neither non-det helpers nor async
// operations), and `view` returns UTF-8 bytes directly rather than
// structured `ui-element` variants (Choice C). The component model
// emits only the imports the fixture actually uses; since this WIT
// does not declare those imports the produced component will not import
// them, which is a valid subset of the ambient set per architecture.md §3.5.
package myrhiza:kernel@1.0.0;

interface types {
    variant verdict {
        accept,
        reject(string),
    }
}

interface host-deterministic {
    hash: func(bytes: list<u8>) -> list<u8>;
    log: func(level: u8, msg: string);
}

world interaction {
    import host-deterministic;
    export view: func(state: list<u8>, peer-state: list<u8>) -> list<u8>;
    export dispatch: func(action: string) -> result<list<u8>, string>;
    export on-broadcast-completion: func(token: list<u8>, ok: bool, err: string);
    export on-blob-fetch-completion: func(token: list<u8>, ok: bool, payload: list<u8>, err: string);
}
