// Pre-check rejector fixture: `apply` always returns
// `Verdict::Reject("not allowed")`. Exercises the kernel's
// fail-closed semantics per convergence.md §4.4 — pre-check
// returning Reject must NOT lead to a commit.
package myrhiza:kernel@1.0.0;

interface types {
    variant verdict {
        accept,
        reject(string),
    }
}

interface host-deterministic {
    hash: func(bytes: list<u8>) -> list<u8>;
    log: func(level: u8, msg: string);
}

world state-apply {
    import host-deterministic;
    use types.{verdict};
    export apply: func(prior-state: list<u8>, event: list<u8>) ->
        tuple<verdict, list<u8>>;
    export state-digest: func(state: list<u8>) -> list<u8>;
}
